# RAMS deployment environment
# Do not commit real secrets.

APP_NAME=Road Asset Management System
DEBUG=false

# Docker Compose database settings
POSTGRES_DB=rams
POSTGRES_USER=rams_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://rams_user:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/rams

# Browser/API security
# Comma-separated browser origins allowed to call the API (login, dashboard, etc.)
# Vercel frontends (https://*.vercel.app) are also allowed via allow_origin_regex in main.py.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://andem.vercel.app
# Include your Render hostname so health checks and host header validation work
TRUSTED_HOSTS=localhost,127.0.0.1,rams-backend-3zlb.onrender.com,.onrender.com

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI (weights not in Git — train or place a .pt file)
AI_MODEL_PATH=models/road_defect.pt
AI_CONFIDENCE_THRESHOLD=0.25
# true = allow /ai-detect without weights (returns no detections; for demos/CI)
AI_STUB_MODE=false

# Optional local ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
