# Application
APP_NAME=Road Asset Management System
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://rams_user:change_me@localhost:5432/rams

# Authentication
# Use a randomly generated secret of at least 32 characters.
# Never commit the real JWT secret to Git.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI
AI_MODEL_PATH=models/road_defect.pt
AI_CONFIDENCE_THRESHOLD=0.25
