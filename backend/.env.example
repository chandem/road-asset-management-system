# RAMS deployment environment
# Do not commit real secrets.

APP_NAME=Road Asset Management System
DEBUG=false

# Docker Compose database settings
POSTGRES_DB=rams
POSTGRES_USER=rams_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://rams_user:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/rams

# Browser/API security
CORS_ALLOWED_ORIGINS=https://rams.example.com
TRUSTED_HOSTS=rams.example.com

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI
AI_MODEL_PATH=models/road_defect.pt
AI_CONFIDENCE_THRESHOLD=0.25

# Optional local ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
