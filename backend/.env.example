# Application
APP_NAME=Road Asset Management System
DEBUG=false

# Database
# Replace with your deployment PostgreSQL/PostGIS connection string.
DATABASE_URL=postgresql+psycopg://rams_user:REPLACE_WITH_STRONG_PASSWORD@db:5432/rams

# Authentication
# Use a randomly generated secret of at least 32 characters.
# Never commit the real JWT secret to Git.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser/API security
# Use exact origins and hostnames in production; comma-separated.
CORS_ALLOWED_ORIGINS=https://rams.example.com
TRUSTED_HOSTS=rams.example.com

# AI
AI_MODEL_PATH=models/road_defect.pt
AI_CONFIDENCE_THRESHOLD=0.25
