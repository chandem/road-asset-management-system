# Root-level example for Docker Compose / local development
# Copy to .env if you want to override values.

# Database (used by docker-compose and local runs)
POSTGRES_DB=rams
POSTGRES_USER=rams_user
POSTGRES_PASSWORD=change_me

# Backend
DATABASE_URL=postgresql+psycopg://rams_user:change_me@localhost:5432/rams
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=true
APP_NAME=Road Asset Management System

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
